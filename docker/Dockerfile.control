FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

ARG ANSIBLE_VERSION=10.7.0

RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client \
        git \
        python3 \
        python3-pip \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Pinned Ansible release (bundles community.general) for reproducible runs
RUN pip3 install --no-cache-dir "ansible==${ANSIBLE_VERSION}"

# Lab nodes are recreated often, so host keys change: skip host key checks.
RUN install -d -m 700 /root/.ssh \
    && printf 'Host *\n\tStrictHostKeyChecking no\n\tUserKnownHostsFile /dev/null\n\tIdentityFile /root/.ssh/id_ed25519\n' > /root/.ssh/config \
    && chmod 600 /root/.ssh/config

COPY control-entrypoint.sh /usr/local/bin/entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sleep", "infinity"]
