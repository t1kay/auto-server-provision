FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ARG LAB_USER=t1kayyyy
ENV LAB_USER=${LAB_USER}

RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server \
        python3 \
        python3-apt \
        sudo \
        iproute2 \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd

# Ansible user with passwordless sudo
RUN useradd -m -s /bin/bash -G sudo "${LAB_USER}" \
    && echo "${LAB_USER} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${LAB_USER}" \
    && chmod 0440 "/etc/sudoers.d/${LAB_USER}"

COPY node-entrypoint.sh /usr/local/bin/entrypoint.sh

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
